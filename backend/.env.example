APP_NAME=Ebook Analyzer API
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ebook_analyzer
REDIS_URL=redis://localhost:6379
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_FALLBACK_MODELS=gemini-2.5-flash-lite
LLM_PROVIDER=openai
ALLOW_MOCK_LLM=false
EXTRACTION_CONCURRENCY=2
EXTRACTION_MAX_ATTEMPTS=3
EXTRACTION_RETRY_BASE_SECONDS=1
EXTRACTION_RETRY_MAX_SECONDS=20
EXTRACTION_REQUESTS_PER_MINUTE=5
EXTRACTION_BATCH_SIZE=3
EXTRACTION_JOB_TIMEOUT_SECONDS=3600
# Signs the anonymous session token. Change this outside local development; a
# non-empty value of at least 32 bytes is required for a stable HS256 secret.
JWT_SECRET=dev-insecure-secret-change-me-use-a-real-one
# Set to true and serve over HTTPS so the session cookie is only sent on TLS.
SESSION_COOKIE_SECURE=false
# Origins allowed to send the session cookie. A wildcard is not valid here.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Anonymous sessions one client IP may create per window.
SESSION_RATE_LIMIT=10
SESSION_RATE_LIMIT_WINDOW_SECONDS=60
# Only enable behind a proxy you control: clients can forge X-Forwarded-For.
TRUST_FORWARDED_FOR=false
